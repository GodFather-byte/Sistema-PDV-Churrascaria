@inject CardapioService Cardapio

<div class="seletor-produtos">
    @if (ComBusca)
    {
        <input id="@IdBusca" class="form-control seletor-busca" placeholder="Buscar produto…" @bind="_busca" @bind:event="oninput" autocomplete="off" />
    }
    <div class="seletor-categorias">
        @foreach (var categoria in _categorias)
        {
            <button type="button" class="chip @(categoria.Id == _categoriaId && string.IsNullOrWhiteSpace(_busca) ? "ativo" : string.Empty)"
                    @onclick="() => { _categoriaId = categoria.Id; _busca = string.Empty; }">
                @categoria.Nome
            </button>
        }
    </div>
    <div class="seletor-grade">
        @foreach (var produto in ProdutosVisiveis)
        {
            <button type="button" class="produto" @onclick="() => Escolher(produto)">
                <span class="produto-nome">@produto.Nome</span>
                <span class="produto-preco">@Formato.Moeda(produto.Preco)</span>
                @if (produto.TemModificadores)
                {
                    <span class="produto-mod">opções</span>
                }
            </button>
        }
        @if (!ProdutosVisiveis.Any())
        {
            <div class="text-muted p-3">Nenhum produto encontrado.</div>
        }
    </div>
</div>

<Modal Aberto="_produtoModificador is not null" Titulo="@(_produtoModificador?.Nome ?? string.Empty)" Classe="modal-modificadores" OnFechar="FecharModificadores">
    <ChildContent>
        @if (_produtoModificador is { } produto)
        {
            @foreach (var grupo in produto.Grupos.Where(g => g.Opcoes.Count > 0))
            {
                <div class="grupo-modificador">
                    <div class="grupo-modificador-titulo">
                        @grupo.Nome
                        @if (grupo.Sabores)
                        {
                            <span class="text-muted small">até @produto.MaximoSabores sabores · partes iguais · @produto.RegraPrecoSabores</span>
                        }
                        @if (grupo.Obrigatorio)
                        {
                            <span class="badge bg-warning text-dark">obrigatório</span>
                        }
                        else if (!grupo.SelecaoUnica)
                        {
                            <span class="text-muted small">pode marcar vários</span>
                        }
                    </div>
                    <div class="grupo-modificador-opcoes">
                        @foreach (var opcao in grupo.Opcoes)
                        {
                            <button type="button" class="opcao @(_opcoesSelecionadas.Contains(opcao.Id) ? "ativo" : string.Empty)"
                                    @onclick="() => AlternarOpcao(grupo, opcao)">
                                @opcao.Nome
                                @if (opcao.Preco > 0 || grupo.Sabores)
                                {
                                    <span>@Formato.Moeda(opcao.Preco)</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
            <div class="grupo-modificador">
                <div class="grupo-modificador-titulo">Observação</div>
                <input class="form-control form-control-lg" maxlength="120" placeholder="Ex.: sem cebola" @bind="_observacao" />
            </div>
            <div class="modificador-quantidade">
                <button type="button" @onclick="() => _quantidade = Math.Max(1, _quantidade - 1)">−</button>
                <span>@_quantidade</span>
                <button type="button" @onclick="() => _quantidade = Math.Min(99, _quantidade + 1)">+</button>
            </div>
            @if (_erroModificador is not null)
            {
                <div class="text-danger fw-bold mt-2">@_erroModificador</div>
            }
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-lg btn-secondary" @onclick="FecharModificadores">Cancelar</button>
        <button type="button" class="btn btn-lg btn-brasa flex-grow-1" @onclick="ConfirmarModificadores">
            Adicionar @PrecoSelecao
        </button>
    </Rodape>
</Modal>

@code {
    [Parameter] public EventCallback<ItemCarrinho> OnAdicionar { get; set; }
    [Parameter] public bool ComBusca { get; set; }
    [Parameter] public string IdBusca { get; set; } = "busca-produto";

    private List<CategoriaCardapio> _categorias = [];
    private int _categoriaId;
    private string _busca = string.Empty;

    private ProdutoCardapio? _produtoModificador;
    private readonly HashSet<int> _opcoesSelecionadas = [];
    private string? _observacao;
    private int _quantidade = 1;
    private string? _erroModificador;
    private string PrecoSelecao
    {
        get
        {
            if (_produtoModificador is null) return string.Empty;
            try
            {
                return Formato.Moeda(CalculoPrecoProduto.Calcular(_produtoModificador, _opcoesSelecionadas) * _quantidade);
            }
            catch (RegraNegocioException ex)
            {
                return $"· {ex.Message}";
            }
        }
    }

    private IEnumerable<ProdutoCardapio> ProdutosVisiveis => string.IsNullOrWhiteSpace(_busca)
        ? _categorias.FirstOrDefault(c => c.Id == _categoriaId)?.Produtos ?? []
        : _categorias.SelectMany(c => c.Produtos).Where(p => p.Nome.Contains(_busca.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _categorias = await Cardapio.ObterCardapioAsync();
        _categoriaId = _categorias.FirstOrDefault()?.Id ?? 0;
    }

    private async Task Escolher(ProdutoCardapio produto)
    {
        if (produto.TemModificadores)
        {
            _produtoModificador = produto;
            _opcoesSelecionadas.Clear();
            _observacao = null;
            _quantidade = 1;
            _erroModificador = null;
            return;
        }

        await OnAdicionar.InvokeAsync(new ItemCarrinho { Produto = produto });
    }

    private void AlternarOpcao(GrupoCardapio grupo, OpcaoCardapio opcao)
    {
        if (_opcoesSelecionadas.Remove(opcao.Id))
        {
            return;
        }

        if (grupo.SelecaoUnica)
        {
            foreach (var outra in grupo.Opcoes)
            {
                _opcoesSelecionadas.Remove(outra.Id);
            }
            if (grupo.Sabores && grupo.Opcoes.Count(o => _opcoesSelecionadas.Contains(o.Id)) >= _produtoModificador!.MaximoSabores)
            {
                _erroModificador = $"Escolha até {_produtoModificador.MaximoSabores} sabores.";
                return;
            }
        }

        _opcoesSelecionadas.Add(opcao.Id);
        _erroModificador = null;
    }

    private async Task ConfirmarModificadores()
    {
        if (_produtoModificador is not { } produto)
        {
            return;
        }

        try
        {
            CalculoPrecoProduto.Calcular(produto, _opcoesSelecionadas);
        }
        catch (RegraNegocioException ex)
        {
            _erroModificador = ex.Message;
            return;
        }

        var opcoes = produto.Grupos.SelectMany(g => g.Opcoes).Where(o => _opcoesSelecionadas.Contains(o.Id)).ToList();
        await OnAdicionar.InvokeAsync(new ItemCarrinho
        {
            Produto = produto,
            Quantidade = _quantidade,
            OpcoesIds = opcoes.Select(o => o.Id).ToList(),
            OpcoesNomes = opcoes.Select(o => o.Nome).ToList(),
            Observacao = string.IsNullOrWhiteSpace(_observacao) ? null : _observacao.Trim()
        });
        _produtoModificador = null;
    }

    private void FecharModificadores() => _produtoModificador = null;
}
